# Copy to /etc/siem/siem.env on the server (chmod 600, owned by siem).
# Generate each secret with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

SIEM_HOST=127.0.0.1
SIEM_PORT=5050
SIEM_DB_PATH=/var/lib/siem/siem.db
SIEM_FRONTEND_DIST=/opt/siem/frontend/dist

# Behind Caddy at https://<domain>/siem/
SIEM_TRUST_PROXY=true
SIEM_COOKIE_SECURE=true
SIEM_COOKIE_PATH=/siem

# Secrets (replace)
SIEM_SECRET_KEY=change-me
SIEM_INGEST_KEY=change-me
SIEM_ADMIN_PASSWORD=change-me

# Attack scenarios on request; no background fake traffic.
SIEM_SIMULATOR=true
SIEM_NOISE_RATE=0

# Receive the server's own logs from rsyslog (see rsyslog-siem.conf).
SIEM_SYSLOG_HOST=127.0.0.1
SIEM_SYSLOG_PORT=5514
